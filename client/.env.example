# Next.js Application Environment Variables Example

# .NET BFF Backend API URL (Server-side, Route Handlers & Edge Middleware)
DOTNET_API_URL=http://localhost:5045

# Public API URL (Client-side / Browser - Empty string for same-origin Next.js BFF routes)
NEXT_PUBLIC_API_URL=

# Application Details
NEXT_PUBLIC_APP_NAME="LMS SaaS"
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=apex-english
