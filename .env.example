# ==============================================================================
# LMS SaaS Backend Environment Variables Template (.env.example)
# Sao chép file này thành .env và điền các giá trị cấu hình tương ứng cho môi trường của bạn.
# ==============================================================================

# Database Connection (Supabase PostgreSQL Connection Pooling)
SUPABASE_CONNECTION_STRING=Host=aws-0-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your-project-ref;Password=your-strong-password;SSL Mode=Require;Trust Server Certificate=true

# JWT Authentication Secret Key (HMAC-SHA256 - tối thiểu 32 ký tự bảo mật)
JWT_SECRET_KEY=YourSuperSecretKeyMustBeVeryLongAndSecureForLmsSaaS2026!#@$

# RabbitMQ Message Broker Credentials
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
